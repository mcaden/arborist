{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Default capability granted to the main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ping",
    "allow-config",
    "allow-shell-command-trust",
    "allow-session",
    "allow-frontend-ready",
    "allow-worktrees-list",
    "allow-branches-list",
    "allow-worktree-git-status",
    "allow-worktree-pr-info",
    "allow-open-external-url",
    "allow-workspace-validate",
    "allow-workspace-switch",
    "allow-worktree-create",
    "allow-worktree-create-from-branch",
    "allow-worktree-prep-open-log",
    "allow-subsession",
    "allow-subsession-icon",
    "allow-worktree-tab",
    "allow-dialog-pick-directory"
  ]
}
